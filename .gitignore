# Zig build artifacts
.zig-cache/
zig-out/

# Coverage outputs
/coverage/

# Devcontainer secrets and local state — the .env entry is mandatory in every
# corelib-* repository (ARCHITECTURE §11.2).
.devcontainer/.env
.devcontainer/.claude-config/

# Editor / OS cruft
*.swp
.DS_Store
# Core dumps — a deliberately crashing test (or a debugger session) drops one
# here, and it is tens of megabytes.
/core
/core.*
